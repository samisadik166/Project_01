import 'package:flutter/material.dart';
import '../utils/app_colors.dart';

class DrawingPath {
  final List<Offset> points;
  final Color color;
  final double strokeWidth;

  const DrawingPath({
    required this.points,
    required this.color,
    required this.strokeWidth,
  });
}

class DrawingPage extends StatefulWidget {
  const DrawingPage({super.key});

  @override
  State<DrawingPage> createState() => _DrawingPageState();
}

class _DrawingPageState extends State<DrawingPage> {
  final List<DrawingPath> _paths = [];
  DrawingPath? _currentPath;

  Color _selectedColor = AppColors.purple;
  double _strokeWidth = 5.0;

  final List<Color> _colorPalette = [
    Colors.black,
    Colors.white,
    Colors.red,
    Colors.blue,
    Colors.green,
    Colors.orange,
    AppColors.pink,
    AppColors.yellow,
    AppColors.teal,
    AppColors.purple,
  ];

  void _onPanStart(DragStartDetails details) {
    setState(() {
      _currentPath = DrawingPath(
        points: [details.localPosition],
        color: _selectedColor,
        strokeWidth: _strokeWidth,
      );
    });
  }

  void _onPanUpdate(DragUpdateDetails details) {
    setState(() {
      if (_currentPath != null) {
        _currentPath = DrawingPath(
          points: [..._currentPath!.points, details.localPosition],
          color: _currentPath!.color,
          strokeWidth: _currentPath!.strokeWidth,
        );
      }
    });
  }

  void _onPanEnd(DragEndDetails details) {
    setState(() {
      if (_currentPath != null) {
        _paths.add(_currentPath!);
        _currentPath = null;
      }
    });
  }

  void _undo() {
    if (_paths.isNotEmpty) {
      setState(() {
        _paths.removeLast();
      });
    }
  }

  void _clear() {
    setState(() {
      _paths.clear();
      _currentPath = null;
    });
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        title: const Text('Drawing & Coloring'),
        backgroundColor: AppColors.purple,
        foregroundColor: Colors.white,
        actions: [
          IconButton(
            icon: const Icon(Icons.undo_rounded, size: 28),
            onPressed: _paths.isNotEmpty ? _undo : null,
            tooltip: 'Undo',
          ),
          IconButton(
            icon: const Icon(Icons.delete_sweep_rounded, size: 28),
            onPressed: _paths.isNotEmpty || _currentPath != null ? _clear : null,
            tooltip: 'Clear',
          ),
        ],
      ),
      body: Column(
        children: [
          Expanded(
            child: Container(
              color: Colors.white,
              child: GestureDetector(
                onPanStart: _onPanStart,
                onPanUpdate: _onPanUpdate,
                onPanEnd: _onPanEnd,
                child: CustomPaint(
                  painter: _DrawingPainter(
                    paths: _paths,
                    currentPath: _currentPath,
                  ),
                  size: Size.infinite,
                ),
              ),
            ),
          ),
          _buildControls(),
        ],
      ),
    );
  }

  Widget _buildControls() {
    return Container(
      padding: const EdgeInsets.symmetric(vertical: 16, horizontal: 12),
      decoration: BoxDecoration(
        color: AppColors.lightGray,
        boxShadow: [
          BoxShadow(
            color: Colors.black12,
            blurRadius: 4,
            offset: const Offset(0, -2),
          ),
        ],
      ),
      child: Column(
        mainAxisSize: MainAxisSize.min,
        children: [
          // Stroke width slider with visual preview
          Row(
            children: [
              const Icon(Icons.brush, color: AppColors.darkGray),
              const SizedBox(width: 8),
              Expanded(
                child: Slider(
                  value: _strokeWidth,
                  min: 1.0,
                  max: 30.0,
                  divisions: 29,
                  activeColor: AppColors.purple,
                  inactiveColor: AppColors.purple.withOpacity(0.3),
                  onChanged: (value) {
                    setState(() {
                      _strokeWidth = value;
                    });
                  },
                ),
              ),
              const SizedBox(width: 8),
              // Visual preview of stroke size
              Container(
                width: _strokeWidth + 4,
                height: _strokeWidth + 4,
                decoration: BoxDecoration(
                  color: AppColors.darkGray,
                  shape: BoxShape.circle,
                ),
              ),
              const SizedBox(width: 12),
            ],
          ),
          const SizedBox(height: 12),
          // Color palette
          Wrap(
            spacing: 12,
            runSpacing: 12,
            alignment: WrapAlignment.center,
            children: _colorPalette.map((color) {
              final isSelected = color == _selectedColor;
              return GestureDetector(
                onTap: () {
                  setState(() {
                    _selectedColor = color;
                  });
                },
                child: Container(
                  width: 44,
                  height: 44,
                  decoration: BoxDecoration(
                    color: color,
                    shape: BoxShape.circle,
                    border: Border.all(
                      color: isSelected ? Colors.white : Colors.grey.shade300,
                      width: isSelected ? 4 : 1,
                    ),
                    boxShadow: [
                      BoxShadow(
                        color: Colors.black26,
                        blurRadius: 2,
                        offset: const Offset(0, 1),
                      ),
                    ],
                  ),
                ),
              );
            }).toList(),
          ),
        ],
      ),
    );
  }
}

class _DrawingPainter extends CustomPainter {
  final List<DrawingPath> paths;
  final DrawingPath? currentPath;

  _DrawingPainter({required this.paths, this.currentPath});

  @override
  void paint(Canvas canvas, Size size) {
    for (var path in paths) {
      _drawPath(canvas, path);
    }
    if (currentPath != null) {
      _drawPath(canvas, currentPath!);
    }
  }

  void _drawPath(Canvas canvas, DrawingPath path) {
    if (path.points.isEmpty) return;

    final paint = Paint()
      ..color = path.color
      ..strokeCap = StrokeCap.round
      ..strokeWidth = path.strokeWidth
      ..style = PaintingStyle.stroke;

    if (path.points.length == 1) {
      // Draw a dot for single tap
      canvas.drawCircle(path.points.first, path.strokeWidth / 2, paint);
      return;
    }

    final pathObj = Path();
    pathObj.moveTo(path.points.first.dx, path.points.first.dy);

    for (int i = 1; i < path.points.length; i++) {
      pathObj.lineTo(path.points[i].dx, path.points[i].dy);
    }

    canvas.drawPath(pathObj, paint);
  }

  @override
  bool shouldRepaint(covariant _DrawingPainter oldDelegate) {
    return true;
  }
}
